# ──────────────────────────────────────────
# AI Prompt Governance Platform – Environment
# Copy to .env and fill in your values
# ──────────────────────────────────────────

# Application
APP_NAME="AI Governance Platform"
APP_VERSION="1.0.0"
DEBUG=false

# Database (SQLite – default for local/PoC; swap for PostgreSQL+asyncpg in production)
DATABASE_URL=sqlite+aiosqlite:///./governance.db

# JWT Authentication  (change SECRET_KEY in production!)
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── LLM Provider: Groq ────────────────────────────────
# Leave empty to use the built-in mock LLM: the whole governance pipeline still
# runs and nothing is sent to Groq. Any non-empty value is used as a real key,
# so do not leave a placeholder here. Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Available models: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768 | gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile

# Knowledge Shield
# Blocking and warning thresholds are policy rules (Settings page), not settings.
# This one only sets when the advisory same-topic warning fires; it never blocks.
KNOWLEDGE_SHIELD_THRESHOLD=0.55

# Models (optional – need requirements-ml.txt)
# NER indexes names of people and companies in protected documents; without it
# only identifiers (SSNs, card numbers, contract numbers…) are protected.
NER_MODEL=dslim/distilbert-NER
# Embeddings power the advisory same-topic warning.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# CORS (comma-separated frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis cache (optional — Knowledge Shield similarity results; runs uncached
# if this is unreachable or the redis package isn't installed)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=604800
