# ──────────────────────────────────────────
# AI Prompt Governance Platform – Environment
# Copy to .env and fill in your values
# ──────────────────────────────────────────

# Application
APP_NAME="AI Governance Platform"
APP_VERSION="1.0.0"
DEBUG=false

# Database for running the backend directly (uvicorn). SQLite needs no setup.
# Docker Compose ignores this and uses its own Postgres container.
DATABASE_URL=sqlite+aiosqlite:///./governance.db
# Or any Postgres:
# DATABASE_URL=postgresql+asyncpg://governance:PASSWORD@localhost:5432/governance

# Password for Docker Compose's Postgres. Empty means the development default,
# "governance" - set a real one for anything beyond local use. It goes into a
# URL, so use letters and digits. Postgres stores it when its volume is first
# created; changing it later needs ALTER USER, or a new volume.
POSTGRES_PASSWORD=

# JWT Authentication  (change SECRET_KEY in production!)
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── LLM Provider: Groq ────────────────────────────────
# Leave empty to use the built-in mock LLM: the whole governance pipeline still
# runs and nothing is sent to Groq. Any non-empty value is used as a real key,
# so do not leave a placeholder here. Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# The default model. Groq retires models over time; pick a current one from
# https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# ── Detection service ─────────────────────────────
# The backend sends every prompt and answer here to be checked; if it cannot
# answer, the prompt is refused, never sent unchecked. Docker Compose sets the
# URL itself.
DETECTION_URL=http://localhost:8002
# Shared secret, sent as a bearer token; set the same value for the detection
# service. Empty on both means unauthenticated, which is fine only while the
# service is reachable by the backend alone (as in Docker Compose).
DETECTION_TOKEN=

# CORS (comma-separated frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Detection service's own settings ──────────────
# Read by the detection service (from detection/.env or the environment); the
# backend ignores them. The defaults are shown and need no change to run.
#
# Its database. Separate from the backend's: it holds the protected documents.
# DATABASE_URL=sqlite+aiosqlite:///./detection.db
#
# Blocking and warning thresholds are policy rules (Settings page), not
# settings. This only sets when the advisory same-topic warning fires.
# KNOWLEDGE_SHIELD_THRESHOLD=0.55
#
# Models (optional - need detection/requirements-ml.txt). NER indexes names of
# people and companies in protected documents; without it only identifiers
# (SSNs, card numbers, contract numbers...) are protected. Embeddings power the
# advisory same-topic warning.
# NER_MODEL=dslim/distilbert-NER
# EMBEDDING_MODEL=all-MiniLM-L6-v2
#
# Redis cache for similarity results; runs uncached if unreachable.
# REDIS_URL=redis://localhost:6379/0
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=604800
